# ROOM S A — Environment Configuration Template (Milestone 2: Rewrite Reality)
#
# NOTE: The game is 100% playable OFFLINE without any backend or API key.
# All secret credentials belong exclusively on the Fastify backend server.
# NEVER expose AI provider API keys to client bundles or commit them to Git.

# -------------------------------------------------------------
# Backend Proxy Server Configuration (server/)
# -------------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# AI Provider choice: 'mock' (default deterministic parser, no key needed) or 'gemini'
AI_PROVIDER=mock

# Google Gemini API key (REQUIRED only if AI_PROVIDER=gemini)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# Model selection (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Proxy request timeout in milliseconds
REQUEST_TIMEOUT_MS=5000

# -------------------------------------------------------------
# Frontend Client Configuration (Vite)
# -------------------------------------------------------------
# Backend proxy endpoint (read by client to connect to Fastify)
VITE_BACKEND_API_URL=http://localhost:3001
